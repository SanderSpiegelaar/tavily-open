# Compose substitutions
APP_PORT=8000
PYTHON_IMAGE=python:3.11-slim
SEARXNG_IMAGE=ghcr.io/searxng/searxng:latest
REDIS_IMAGE=redis:7-alpine
READER_IMAGE=ghcr.io/intergalacticalvariable/reader:latest
BROWSERLESS_IMAGE=ghcr.io/browserless/chromium:latest
SEARXNG_SECRET=replace-with-a-long-random-value
BROWSERLESS_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# API runtime
API_HOST=0.0.0.0
API_PORT=3000
SEARCH_PROVIDER=router
SEARCH_ROUTE_PROVIDERS=local,searxng
EXTERNAL_SEARCH_ENABLED=false
SEARXNG_URL=http://searxng:8080

# Keep the demo lightweight and persistent
CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
LOCAL_INDEX_ENABLED=true
LOCAL_INDEX_PATH=/app/data/trailsearch.sqlite3
BACKFILL_ENABLED=true
BACKFILL_QUEUE_BACKEND=redis
ETCD_ENABLED=false

# Full extraction pipeline: HTTP -> Reader -> remote Chromium fallback.
READER_ENABLED=true
READER_URL=http://reader:3000
READER_URLS=http://reader:3000
CRAWL_EXTRACTION_STRATEGY=quality_gated
BROWSER_BACKEND=remote
BROWSERLESS_WS_URL=ws://browserless:3000
BROWSER_REMOTE_MAX_CONCURRENCY=2
BROWSER_TEXT_MODE=false
BROWSER_LIGHT_MODE=true
BROWSER_LOCAL_FALLBACK_ENABLED=false
